{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=clean_db;Username=postgres;Password=postgres;Search Path=clean"
  },
  "Jwt": {
    "Issuer": "clean-api",
    "Audience": "clean-client",
    "Key": "super_secret_key_change_me_in_production_at_least_32_chars!",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}